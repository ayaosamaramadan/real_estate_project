<odoo>

    <record id="crm_lead_view_form_inherit" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form" />
        <field name="arch" type="xml">
            <header>
                <button name="%(action_property)d" type="action" 
                context="{'default_lead_id': active_id , 'default_name': name}"
                string="Open Property"
                    class="btn-primary" />
                <button name="action_open_create_tenant_wizard" type="object"
                    string="Create Tenant" class="btn-primary" />
            </header>
            <xpath expr="//field[@name='user_id']" position="before">
                <field name="property_type" />
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="string">sales man</attribute>
            </xpath>
            <xpath expr="//field[@name='date_deadline']" position="attributes">
                <attribute name="string">expected date</attribute>
                <attribute name="required">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="ir_cron_create_tenants_from_leads" model="ir.cron">
        <field name="name">Real Estate: Create Tenants from Leads</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="state">code</field>
        <field name="code">model._cron_create_tenants_from_leads()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now().replace(hour=1, minute=0, second=0) + relativedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>


</odoo>