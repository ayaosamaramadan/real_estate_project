<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- Maintenance Report Wizard Form -->
    <record id="view_maintenance_report_wizard_form"
            model="ir.ui.view">

        <field name="name">maintenance.report.wizard.form</field>

        <field name="model">maintenance.report.wizard</field>

        <field name="arch" type="xml">

            <form string="Maintenance Report">

                <group>

                    <!-- Date Filters -->
                    <group string="Date">
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>

                    <!-- Maintenance Filters -->
                    <group string="Maintenance Filters">

                        <!-- Required -->
                        <field name="issue_type"/>

                        <!-- Optional -->
                        <field name="urgency"/>

                    </group>

                </group>

                <!-- Property / Tenant -->
                <group string="Property / Tenant">

                    <field name="property_id"/>

                    <field name="tenant_id"/>

                </group>

                <!-- Download Excel -->
                <group string="Download Report"
                       invisible="not excel_file">

                    <field name="excel_filename"
                           invisible="1"/>

                    <field name="excel_file"
                           filename="excel_filename"
                           widget="binary"
                           string="Excel File"/>

                </group>

                <footer>

                    <button name="action_generate_report"
                            string="Generate Excel"
                            type="object"
                            class="btn-primary"/>

                    <button string="Close"
                            special="cancel"
                            class="btn-secondary"/>

                </footer>

            </form>

        </field>

    </record>


    <!-- Maintenance Report Window Action -->
    <record id="action_maintenance_report_wizard"
            model="ir.actions.act_window">

        <field name="name">Maintenance Report</field>

        <field name="res_model">maintenance.report.wizard</field>

        <field name="view_mode">form</field>

        <field name="view_id"
               ref="view_maintenance_report_wizard_form"/>

        <field name="target">new</field>

    </record>

</odoo>