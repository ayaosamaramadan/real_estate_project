<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action View -->
    <record id="action_tenant" model="ir.actions.act_window">
        <field name="name">Tenants</field>
        <field name="res_model">real_estate.tenant</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Tenant
            </p>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_tenant_form" model="ir.ui.view">
        <field name="name">real_estate.tenant.form</field>
        <field name="model">real_estate.tenant</field>
        <field name="arch" type="xml">
            <form string="Tenant">
                <header>
                    <button name="update_notes" type="object" string="Update Notes"
                        class="btn-primary" />
                    <button name="get_lead_name" type="object" string="Get Lead Name"
                        class="btn-primary" />
                    <button name="get_lead_email" type="object" string="Get Lead Email"
                        class="btn-primary" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Tenant Name" />
                        </h1>
                    </div>
                    <group string="Contact Details">
                        <group>
                            <field name="email" />
                            <field name="user_id" string="Portal User" />
                            <field name="phone" />
                            <field name="mobile" />
                        </group>
                        <group>
                            <field name="city" />
                            <field name="date_of_birth" />
                            <field name="age_category" />
                            <field name="date_joined" />
                              <field name="age_tenant"/>
                        </group>
                    </group>
                    <group>

                        <field name="active" />
                        <field name="crm_id" readonly="1" string="CRM Lead" />
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Add notes about this tenant..." />
                        </page>

                        <page string="Leases">
                            <field name="lease_ids">
                                <tree create="false">
                                    <field name="name"/>
                                  
                                    <field name="tenant_id"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                </tree>
                            </field>                                
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_tenant_tree" model="ir.ui.view">
        <field name="name">real_estate.tenant.tree</field>
        <field name="model">real_estate.tenant</field>
        <field name="arch" type="xml">
            <tree string="Tenants">
                <field name="name" />
                <field name="email" />
                <field name="phone" />
                <field name="mobile" />
                <field name="city" />
                <field name="date_joined" />
                <field name="active" />
            </tree>
        </field>
    </record>

    <!-- Tenant Kanban View -->
    <record id="view_tenant_kanban" model="ir.ui.view">
        <field name="name">real_estate.tenant.kanban</field>
        <field name="model">real_estate.tenant</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name" />
                <field name="email" />
                <field name="date_joined" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name" />
                                </strong>
                                <div class="mb-1">
                                    <field name="email" widget="email" />
                                </div>
                                <div class="text-muted mt-1"> Joined: <field name="date_joined" />
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Tenant Search View -->
    <record id="view_tenant_search" model="ir.ui.view">
        <field name="name">real_estate.tenant.search</field>
        <field name="model">real_estate.tenant</field>
        <field name="arch" type="xml">
            <search string="Search Tenants">
                <field name="name" />
                <field name="email" />
                <field name="phone" />
                <field name="age_category" />
                <separator />
                <filter string="Active" name="active" domain="[('active', '=', True)]" />
                <filter string="Inactive" name="inactive" domain="[('active', '=', False)]" />
                <separator />
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_by_age_category"
                        context="{'group_by': 'age_category'}" />
                    <filter string="age_category" name="group_by_city"
                        context="{'group_by': 'city'}" />
                </group>
            </search>

        </field>
    </record>

</odoo>
