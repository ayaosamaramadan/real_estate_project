<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Property List View (Tree) -->
    <record id="view_property_tree" model="ir.ui.view">
        <field name="name">real_estate.property.tree</field>
        <field name="model">real_estate.property</field>
        <field name="arch" type="xml">
            <tree string="Properties"
                decoration-bf="property_type == 'apartment'"
                decoration-it="property_type == 'office'"
                decoration-danger="property_type == 'shop'"
                decoration-warning="property_type == 'vila'"
                decoration-info="property_type == 'apartment'"
                decoration-success="property_type == 'land'"
                decoration-muted="not available">
                <field name="name" />
                <field name="price" string="Monthly Rent" />
                <field name="description" />
                <field name="bedrooms" />
                <field name="available" />
                <field name="create_date" />
                <field name="create_uid" />
                <field name="agent_id" />
                <field name="property_type" />
            </tree>
        </field>
    </record>


    <!-- Property Form View -->
    <record id="view_property_form" model="ir.ui.view">
        <field name="name">real_estate.property.form</field>
        <field name="model">real_estate.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <header>
                    <button name="mark_as_occupied" string="Mark as Occupied" type="object"
                        invisible="not available" class="oe_highlight" />
                    <button name="mark_as_available" string="Mark as Available" type="object"
                        invisible="available" class="oe_highlight" />
                    <button name="update_description" string="Description" type="object"
                        class="oe_highlight" />
                    <button name="update_deposit" string="Increase Deposit by 1000" type="object"
                        class="oe_highlight" />
                    <button name="add_bedroom" invisible="not available" string="Add Bedroom"
                        type="object" class="oe_highlight" />
                    <button name="prop_vila" string="change prop to vila" type="object"
                        class="oe_highlight" />

                    <button name="get_agent_name" string="Agent Name" type="object"
                        class="oe_highlight" />

                    <button type="action"
                        name="%(action_real_estate_lease_wizard)d"
                        string="Create Lease"
                        context="{'default_property_id': active_id}"
                        class="oe_highlight" />
                </header>


                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="view_leases"
                            string="Leases"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o">
                            <field name="lease_count"
                                widget="statinfo"
                                string="Leases" />
                        </button>

                        <button name="view_main_requests"
                            string="Maintenance"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-wrench">
                            <field name="main_count"
                                widget="statinfo"
                                string="Maintenance" />
                        </button>


                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Property Name" />
                        </h1>
                    </div>
                    <field name="image_1920" widget="image" class="oe_avatar" />
                    <group string="Property Details">
                        <group>
                            <field name="available" />

                        </group>
                        <group>
                            <field name="price" string="Monthly Rent" invisible="not available" />
                            <field name="deposite" string="Deposite amount" />
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="bedrooms" readonly="0" />
                            <field name="area" />
                            <field name="agent_id" readonly="0"
                                groups="real_estate.group_property_manager" />
                        </group>

                        <group>
                            <field name="property_type" readonly="0" />
                        </group>

                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"
                                placeholder="Add description about this property..." />
                        </page>
                        <page string="Leases">
                            <field name="lease_ids">
                                <tree create="false">
                                    <field name="name" />
                                    <field name="tenant_id" />
                                    <field name="start_date" />
                                    <field name="end_date" />

                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Property Action (Links views together) -->
    <record id="action_property" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">real_estate.property</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first property
            </p>
        </field>
    </record>

    <!-- Property Kanban View -->
    <record id="view_property_kanban" model="ir.ui.view">
        <field name="name">real_estate.property.kanban</field>
        <field name="model">real_estate.property</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name" />
                <field name="price" string="Monthly Rent" />
                <field name="bedrooms" />
                <field name="available" />
                <field name="property_type" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name" />
                                </strong>
                                <div class="mt-1"> Monthly Rent: <field name="price" />
                                </div>
                                <div class="text-muted mt-1"> Bedrooms: <field name="bedrooms" />
                                </div>
                                <div class="text-muted mt-1"> Type: <field name="property_type" />
                                </div>
                                <div class="mt-1">
                                    <field name="available" />
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Property Search View -->
    <record id="view_property_search" model="ir.ui.view">
        <field name="name">real_estate.property.search</field>
        <field name="model">real_estate.property</field>
        <field name="arch" type="xml">
            <search string="Search Properties">
                <field name="name" />
                <field name="price" />
                <separator />
                <filter string="Available" name="available" domain="[('available', '=', True)]" />
                <filter string="Not Available" name="not_available"
                    domain="[('available', '=', False)]" />
                <separator />
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_by_type"
                        context="{'group_by': 'property_type'}" />
                    <filter string="Availability" name="group_by_availability"
                        context="{'group_by': 'available'}" />
                </group>
            </search>
        </field>
    </record>


</odoo>
