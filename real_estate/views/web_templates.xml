<odoo>
  <data>
    <template id="website_properties" name="Available Properties">
      <t t-call="website.layout">
        <div id="wrap" class="oe_structure">
          <section class="container py-5">
            <h1 class="text-center mb-4">Available Properties</h1>
            <form action="/properties" method="get" class="row g-3 align-items-end mb-5">
              <div class="flex border rounded p-3 mb-4">
                <div class="row g-3">
                  <div class="col-md-3">
                    <label class="form-label">Property Type</label>
                    <select name="property_type" class="form-select">
                      <option value="">All Types</option>
                      <t t-foreach="property_types" t-as="type">
                        <option t-att-value="type[0]" t-att-selected="type[0] == selected_type">
                          <t t-esc="type[1]" />
                        </option>
                      </t>
                    </select>
                  </div>
                  <div class="col-md-2">
                    <label class="form-label">Min Price</label>
                    <input name="min_price" type="number" min="0" step="0.01" class="form-control"
                      t-att-value="min_price or ''" />
                  </div>
                  <div class="col-md-2">
                    <label class="form-label">Max Price</label>
                    <input name="max_price" type="number" min="0" step="0.01" class="form-control"
                      t-att-value="max_price or ''" />
                  </div>
                  <div class="col-md-2">
                    <label class="form-label">Min Bedrooms</label>
                    <input name="bedrooms" type="number" min="0" class="form-control"
                      t-att-value="bedrooms or ''" />
                  </div>
                </div>
                <div class="col-md-3 mb-2 mt-3">
                  <button class="btn btn-primary" type="submit">Search</button>
                  <a href="/properties" class="btn btn-secondary">Clear</a>
                </div>
              </div>
            </form>

            <div class="row">
              <t t-if="properties">
                <t t-foreach="properties" t-as="property">
                  <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                      <img t-if="property.image_1920"
                        t-att-src="'/web/image/real_estate.property/%s/image_1920' % property.id"
                        t-att-alt="property.name" class="card-img-top"
                        style="height: 210px; object-fit: cover;" />
                      <div t-else=""
                        class="bg-light d-flex align-items-center justify-content-center"
                        style="height: 210px;">No Image</div>
                      <div class="card-body d-flex flex-column">
                        <h5 class="card-title">
                          <t t-esc="property.name" />
                        </h5>
                        <p class="mb-1">
                          <strong>Type:</strong>
                          <t t-esc="property_types_map.get(property.property_type)" />
                        </p>
                        <p class="mb-1">
                          <strong>Bedrooms:</strong>
                          <t t-esc="property.bedrooms" />
                        </p>
                        <p class="mb-3"><strong>Area:</strong> <t t-esc="property.area" /> sq ft</p>
                        <h4 class="mt-auto">$<t t-esc="property.price" /></h4>
                        <a t-att-href="'/properties/%s' % property.id"
                          class="btn btn-outline-primary mt-2">
                          View Details
                        </a>
                      </div>
                    </div>
                  </div>
                </t>
              </t>
              <t t-else="">
                <div class="col-12">
                  <div class="alert alert-info">No properties match your search.</div>
                </div>
              </t>
            </div>
          </section>
        </div>
      </t>
    </template>

    <!-- view details page -->
    <template id="website_property_details" name="Property Details">
      <t t-call="website.layout">
        <div id="wrap" class="oe_structure">
          <section class="container py-5">
            <a href="/properties" class="btn btn-link px-0 mb-3">← Back to Properties</a>
            <div class="row">
              <div class="col-lg-7 mb-4">
                <img t-if="property_record.image_1920"
                  t-att-src="'/web/image/real_estate.property/%s/image_1920' % property_record.id"
                  t-att-alt="property_record.name" class="img-fluid rounded w-100" />
                <div t-else="" class="bg-light p-5 text-center rounded">No Image</div>
              </div>
              <div class="col-lg-5">
                <h1>
                  <t t-esc="property_record.name" />
                </h1>
                <h3 class="text-primary mb-4">$<t t-esc="property_record.price" /> / month</h3>
                <p>
                  <strong>Type:</strong>
                  <t t-esc="property_types_map.get(property_record.property_type)" />
                </p>
                <p>
                  <strong>Bedrooms:</strong>
                  <t t-esc="property_record.bedrooms" />
                </p>
                <p><strong>Area:</strong> <t t-esc="property_record.area" /> sq ft</p>
                <t t-if="property_record.description">
                  <h5 class="mt-4">Description</h5>
                  <p>
                    <t t-esc="property_record.description" />
                  </p>
                </t>
              </div>
            </div>
          </section>
        </div>
      </t>
    </template>

    <record id="website_menu_properties" model="website.menu">
      <field name="name">Properties</field>
      <field name="url">/properties</field>
      <field name="parent_id" ref="website.main_menu" />
      <field name="sequence" type="int">30</field>
    </record>
  </data>
</odoo>